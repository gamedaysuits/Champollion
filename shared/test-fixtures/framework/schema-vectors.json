{
  "_comment": "Conformance vectors for the framework document readers. BOTH runtimes must return exactly `expect` (version, errors, warnings) for each doc: cli/lib/framework/index.js checkDocument() and arena/mt_eval_harness/framework check_document(). Change a reader, re-check every expectation by eye — never regenerate blindly.",
  "cases": [
    {
      "name": "set/0 minimal local-only mark",
      "type": "set",
      "doc": {
        "transmission": "local-only"
      },
      "expect": {
        "version": 0,
        "errors": [],
        "warnings": []
      }
    },
    {
      "name": "set/0 written by register-corpus",
      "type": "set",
      "doc": {
        "id": "school-crk-test",
        "name": "Teacher-checked sentences",
        "license": "LicenseRef-Community-Private",
        "tier": "local-only",
        "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "rows": 120,
        "card": "school-crk-test.json",
        "registeredAt": "2026-10-03T12:00:00Z",
        "transmission": "local-only"
      },
      "expect": {
        "version": 0,
        "errors": [],
        "warnings": []
      }
    },
    {
      "name": "set/0 carried to a derived file",
      "type": "set",
      "doc": {
        "transmission": "local-only",
        "segment": "held_out",
        "license": "CC-BY-4.0",
        "derived_from": "test.tsv",
        "written_by": "nmt-forge split"
      },
      "expect": {
        "version": 0,
        "errors": [],
        "warnings": []
      }
    },
    {
      "name": "set/0 hand-written extra key is a warning",
      "type": "set",
      "doc": {
        "transmission": "local-only",
        "note": "grandpa checked these"
      },
      "expect": {
        "version": 0,
        "errors": [],
        "warnings": [
          "$: unknown key 'note' — kept (this sidecar predates set/1), but set/1 refuses it: rename it 'x-note' or remove it"
        ]
      }
    },
