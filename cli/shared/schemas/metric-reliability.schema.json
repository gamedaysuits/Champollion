{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://champollion.dev/schemas/metric-reliability.schema.json",
  "title": "Metric Reliability Index (WMT meta-evaluation, machine-derived)",
  "description": "Correlations between automatic MT metrics and WMT Metrics-task human judgments (DA/MQM/ESA, wmt19-wmt25), per (test set, language pair, human lane, level, metric), rolled up per TARGET-language family (master plan B3). Every value is champollion-derived from pinned upstream data (google-research/mt-metrics-eval + google/wmt-mqm-human-evaluation); no upstream text, judgment or score is redistributed. RELIABILITY evidence, not quality scores. Non-commercial hold until the founder clears the upstream data license (license_lane). Regenerated by arena/scripts/import_wmt_metaeval.py; tracked in the monorepo, NOT bundled into the npm package or PyPI wheel.",
  "type": "object",
  "required": ["version", "provider", "sources", "provenance", "license_lane", "score_orientation", "correlation_definitions", "human_lanes", "metrics", "languages", "families", "cells", "excluded", "counts"],
  "additionalProperties": false,
  "properties": {
    "_comment": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "provider": { "enum": ["wmt-metrics-metaeval"] },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "repo", "commit", "retrieved", "license", "credit"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string" },
          "repo": { "type": "string", "format": "uri" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "Upstream commit SHA pinned at probe time." },
          "data_url": { "type": "string", "format": "uri" },
          "data_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the downloaded data tarball — REQUIRED for the mt-metrics-eval source because the tarball is not immutable." },
          "data_etag": { "type": ["string", "null"] },
          "data_last_modified": { "type": ["string", "null"] },
          "data_bytes": { "type": ["integer", "null"] },
          "retrieved": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "license": { "type": "string", "minLength": 5 },
          "credit": { "type": "string", "minLength": 10, "description": "Human credit for the upstream project and annotators (always-cite-work principle)." },
          "note": { "type": "string" }
        }
      }
    },
    "provenance": { "type": "string", "pattern": "champollion-derived", "description": "Must carry champollion-derived naming the upstreams: the correlations are our computation; the judgments and scores are theirs." },
    "license_lane": {
      "type": "object",
      "required": ["commercial_ok", "note"],
      "properties": {
        "commercial_ok": { "enum": [false], "description": "Pinned false until the founder license review clears the upstream data — the bundled human-judgment/test-set text has no explicit upstream license statement." },
        "note": { "type": "string", "minLength": 20 }
      }
    },
    "score_orientation": { "type": "string", "minLength": 20 },
    "correlation_definitions": {
      "type": "object",
      "required": ["sys", "seg"],
      "properties": {
        "sys": { "type": "string", "minLength": 20 },
        "seg": { "type": "string", "minLength": 20 }
      }
    },
    "human_lanes": {
      "type": "object",
      "required": ["preference", "note"],
      "properties": {
        "preference": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    },
    "metrics": {
      "type": "object",
      "description": "Keyed by shared/metric-registry.json canonical id. Every cells[].metric MUST appear here (cross-checked by cli/test/metric-reliability.test.js).",
      "additionalProperties": {
        "type": "object",
        "required": ["registry_id", "upstream_candidates", "upstream_names_used", "note"],
        "properties": {
          "registry_id": { "type": "string" },
          "upstream_candidates": { "type": "array", "items": { "type": "string" } },
          "upstream_names_used": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "languages": {
      "type": "object",
      "description": "Every src/tgt code used in cells -> iso639-3 + family/genus from cli/data/champollion.db.",
      "additionalProperties": {
        "type": "object",
        "required": ["iso639_3", "family"],
        "properties": {
          "iso639_3": { "type": "string", "minLength": 2 },
          "family": { "type": ["string", "null"] },
          "genus": { "type": ["string", "null"] }
        }
      }
    },
    "family_rollup_note": { "type": "string" },
    "families": {
      "type": "object",
      "description": "TARGET-language family -> per-metric per-level weighted-mean correlations over preferred cells only.",
      "additionalProperties": {
        "type": "object",
        "required": ["n_pairs", "metrics"],
        "properties": {
          "n_pairs": { "type": "integer", "minimum": 1 },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["n_cells", "n_pairs", "weight", "pairs"],
                "properties": {
                  "n_cells": { "type": "integer", "minimum": 1 },
                  "n_pairs": { "type": "integer", "minimum": 1 },
                  "weight": { "type": "integer", "minimum": 1 },
                  "pairs": { "type": "array", "items": { "type": "string" } },
                  "pearson_weighted_mean": { "type": "number", "minimum": -1, "maximum": 1 },
                  "spearman_weighted_mean": { "type": "number", "minimum": -1, "maximum": 1 },
                  "kendall_tau_b_weighted_mean": { "type": "number", "minimum": -1, "maximum": 1 },
                  "pairwise_accuracy_weighted_mean": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["testset", "pair", "pair_verbatim", "src", "tgt", "human", "level", "preferred", "metric", "upstream_metric", "upstream_ref", "computed", "n_sys"],
        "additionalProperties": false,
        "properties": {
          "testset": { "type": "string" },
          "pair": { "type": "string", "pattern": "^[a-z]{2,3}-[a-z]{2,3}$" },
          "pair_verbatim": { "type": "string" },
          "src": { "type": "string" },
          "tgt": { "type": "string" },
          "human": { "type": "string" },
          "level": { "enum": ["sys", "seg"] },
          "preferred": { "type": "boolean" },
          "metric": { "type": "string" },
          "upstream_metric": { "type": "string" },
          "upstream_ref": { "type": "string" },
          "computed": { "type": "boolean", "description": "true = Champollion computed the metric scores (sacrebleu chrF++ lane); false = scores verbatim from the WMT submission/baseline files." },
          "n_sys": { "type": "integer", "minimum": 2 },
          "n_points": { "type": "integer", "minimum": 10 },
          "pearson": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
          "spearman": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
          "kendall_tau_b": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
          "pairwise_accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "excluded": {
      "type": "array",
      "description": "Fail-honest ledger: everything skipped, with a reason (label-honesty rule A4).",
      "items": {
        "type": "object",
        "required": ["reason"],
        "properties": {
          "testset": { "type": "string" },
          "pair": { "type": "string" },
          "human": { "type": "string" },
          "level": { "type": "string" },
          "metric": { "type": "string" },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": ["cells", "preferred_cells", "testsets", "pairs", "families", "excluded"],
      "properties": {
        "cells": { "type": "integer", "minimum": 0 },
        "preferred_cells": { "type": "integer", "minimum": 0 },
        "testsets": { "type": "integer", "minimum": 0 },
        "pairs": { "type": "integer", "minimum": 0 },
        "families": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
