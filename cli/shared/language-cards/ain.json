    "inclusiveExclusive": {
      "agreement": "incommensurable",
      "values": [
        {
          "value": "1",
          "source": "grambank-v1.0.3",
          "note": "Clusivity is only for the first person plural subject (transitive and intransitive) and object markers. \"It is noted that the exclusive/inclusive categories in the colloquial language developed using the first-person affixes of the classical language as the inclusive forms. The intransitive inclusive affix -an is the intransitive first-person subject affix in the classical language; the transitive inclusive subject affix a- is the transitive first-person subject affix in the classical language; and the transitive inclusive object affix i- is the transitive first-person object affix in the classical language.\" (Shibatani, 1990: 29). Tamura: cóka 1PL.EXCL; aoká 1PL.INCL; Shibatani: no distinction in pronouns, cóka form Not mentioned.; Shibatani: colloquial Ainu: distinction in person marking on the verb",
          "scale": "grambank-v1.0.3"
        },
        {
          "value": "Inclusive/exclusive",
          "source": "wals-v2020.5",
          "scale": "wals-v2020.5"
        }
      ]
    },
