  "politenessDistinction": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "1",
        "source": "grambank-v1.0.3",
        "note": "Classical Ainu: yes, Colloquial Ainu: no",
        "scale": "grambank-v1.0.3"
      },
      {
        "value": "Binary politeness distinction",
        "source": "wals-v2020.5",
        "note": "<div class=\"Example\"><table class=\"example\"><tr><td><p><i>aoka(i)</i></p></td><td><p>2nd sg. hon.</p></td><td></td></tr><tr><td><p><i>aoka(i)</i></p></td><td><p>2nd pl. hon.</p></td><td><p>- in Colloquial Ainu, the Classical Ainu 1st pl <i>aoka</i></p><p>became a 1st pl incl and was used as a polite form of</p><p>address in sg and pl reference;</p><p>- the etymollogy is: <i>a-</i> (1st trans. actor prefix) +<i>oka</i></p><p>(plural form of the verb an 'exist' meaning 'they exist')</p></td></tr></table></div>",
        "scale": "wals-v2020.5"
      }
    ]
