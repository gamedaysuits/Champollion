  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "at risk",
        "source": "elcat-v2024.1",
        "note": "We have gathered evidence that Qemant is not a 'dead' language, but it must be considered endangered. [...] We have met a number of elderly bilingual people who speak both Amharic and Qemant. However, even these people seem to be more proficient in Amharic than in Qemant, and they seem to use Amharic more than Qemant. [...] Linguistically speaking, one could say that Qemant is being replaced by Amharic, and there is a tendency for the language to die. [Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "critically endangered",
        "source": "elcat-v2024.1",
        "note": "A typical speaker: \"He prays and dreams in Kemant. He also speaks about secrets in Kemant\" [only domains which Kemant is used] [Endangerment.Certainty: 0.8]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "severely endangered",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.8]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "moribund",
        "source": "glottolog-cldf-v5.3",
        "note": "K'emant (3793-ahg) = Severely Endangered (80 percent certain, based on the evidence available) [Leyew 2005](cldf:leyew:05)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
