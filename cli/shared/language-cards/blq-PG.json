    "agreement": "incommensurable",
    "values": [
      {
        "value": "vulnerable",
        "source": "elcat-v2024.1",
        "note": "There is extensive cultural pressure to speak Tok Pisin and, to a lesser extent, English. While Tok Pisin is primarily a lingua franca between language groups in PNG, the language is entering into more domains. Often speakers of Paluai use Tok Pisin with each other and may use extensive code-switching and borrowing between the two languages. Specialized registers, such as traditional song genres, are being lost in Paluai. In school, while use of Paluai is encouraged, Tok Pisin is often the primary language used. English is introduced after grade 3. [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "not endangered",
        "source": "glottolog-cldf-v5.3",
        "note": "Paluai (blq-blq) = 6a (Vigorous).",
