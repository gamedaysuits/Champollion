  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "There are relatively few child speakers. Until recently, Azerbaijani, Georgian and Russian were used exclusively in school, and they continue to be used for wider communication. [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "severely endangered",
        "source": "elcat-v2024.1",
        "note": "In Nidzh (and, until 1989, in Vartashen), Udi is spoken by most elder ethnic Udis (50 years and beyond), whereas the knowledge of the language decreases the younger people are. Yet, a considerable number of young Udis still use a (however strongly Azeri influenced) variety of Udi in “internal” communication which can be described as “Young People’s Udi”. The sociolinguistic situation of Udi in Nidzh has become more stable after the immigration of Udis from Vartashen. [Endangerment.Certainty: 0.6]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Udi (3011-udi) = Endangered (100 percent certain, based on the evidence available) (There are relatively few child speakers. Until recently, Azerbaijani, Georgian and Russian were used exclusively in school, and they continue to be used for wider communication.) [Salminen 2007](cldf:salminen:07:2)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
  },
