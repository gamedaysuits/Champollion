  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "A few children in Russia learn the language, but most if not all of them become more fluent in Russian and largely stop using Olonetsian later in life. In Finland, there are a few thousand speakers, all elderly, and even those who are fluent in Olonetsian use mostly Finnish. [Endangerment.Certainty: 0.8]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "vulnerable",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Livvi (3281-olo) = Endangered (80 percent certain, based on the evidence available) (A few children in Russia learn the language, but most if not all of them become more fluent in Russian and largely stop using Olonetsian later in life. In Finland, there are a few thousand speakers, all elderly, and even those who are fluent in Olonetsian use mostly Finnish.) [Salminen 2007](cldf:salminen:07:2)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
