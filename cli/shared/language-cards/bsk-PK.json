  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "Believed to be dwindling fast. [Endangerment.Certainty: 0.4]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "“…dominance of Urdu has resulted in a strong push for a majority of Burushos to shift to Urdu. As a result, many younger generation Burushos only have a receptive proficiency in Burushaski. With greater means of mobility, more and more people have chosen to move to bigger cities for education and employment. As a result, they shift to using Urdu as their primary language. Thus, imperfect knowledge of the language is very common and fluency in Burushaski among the second and third generation is on a rapid decline.\" [Endangerment.Certainty: 0.8]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "vulnerable",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Burushaski (1614-bsk) = Threatened (80 percent certain, based on the evidence available) (“…dominance of Urdu has resulted in a strong push for a majority of Burushos to shift to Urdu. As a result, many younger generation Burushos only have a receptive proficiency in Burushaski. With greater means of mobility, more and more people have chosen to move to bigger cities for education and employment. As a result, they shift to using Urdu as their primary language. Thus, imperfect knowledge of the language is very common and fluency in Burushaski among the second and third generation is on a rapid decline.\") [Munshi 2014](cldf:munshi:14)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
  },
