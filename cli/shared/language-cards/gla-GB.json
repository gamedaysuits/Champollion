    "values": [
      {
        "value": "Binary politeness distinction",
        "source": "wals-v2020.5",
        "note": "<div class=\"Example\"><table class=\"example\"><tr><td><p><i>sibh</i></p></td><td><p>2nd sg. hon.</p></td><td><p>- used by children in addressing their parents, by</p><p>inferiors in addressing superiors, or their elders, and</p><p>generally as a mark of courtesy; 2nd plural agreement</p><p>on verb</p></td></tr><tr><td><p><i>sibh</i></p></td><td><p>2nd sg. hon.</p></td><td><p>- the use of the 2nd pl as a polite form of address is</p><p>widespread in Scottish Gealic;</p><p>- it is used among people of 40 years of age and above</p><p>to address superiors;</p><p>- elders expect to receive the polite use of <i>sibh</i>,</p><p>otherwise speakers are considered impolite</p></td></tr></table></div>",
        "scale": "wals-v2020.5"
      }
    ]
  },
