  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "The linguistic situation does not augur well for the future of Nanai culture. Nowadays, all the Nanais are bilingual. In 1979, 93.2% spoke Russian fluently, and 43.9% even gave Russian as their mother tongue. Only 63% spoke fluent Nanai and it was regarded as the mother tongue by 55.8%. From 1959 to 1979, the number of Nanais who regarded Russian as their mother tongue increased from 13.3% to 43.9%. Research projects in recent years have shown that it is mostly the older generation (as their first language) and the middle-aged (as their second language) who speak fluent Nanai. The younger generation has only a passive command of the language, or they do not speak it at all. [Endangerment.Certainty: 0.4]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "severely endangered",
        "source": "elcat-v2024.1",
        "note": "This language is not passing down to children. People who are above 60 may be able to speak it, whereas people between 40-60 only have passive knowledge about Nanai. Nanai is used only in the home domains between active speakers, and is not the major language for communication even among them. [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "moribund",
        "source": "glottolog-cldf-v5.3",
        "note": "Nanai (1206-gld) = Severely Endangered (100 percent certain, based on the evidence available) (This language is not passing down to children. People who are above 60 may be able to speak it, whereas people between 40-60 only have passive knowledge about Nanai. Nanai is used only in the home domains between active speakers, and is not the major language for communication even among them.) [Tang 2008](cldf:tang:08)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
  },
