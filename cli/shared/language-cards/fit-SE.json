  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "Right to education, medical care, legal proceedings, minimum hours of radio broadcasting in the language\r\n\r\nThe Meänakateemi/Academia Tornedaliensis foundation is carrying out ongoing scientific projects including bilingual Meänkieli/Swedish dictionary, vocabulary & place names, digital corpus, history book about the community. \r\n\r\nThere are several theater troups, musical bands, literary authors and local festivals that showcase creative works in Meänkieli. Language is the single clear cultural symbol. [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "severely endangered",
        "source": "elcat-v2024.1",
        "note": "Meäinkieli is the focus of several cultural festivals and a few novels. \r\n\r\nNational minorities have the right to learn, develop and use their languages.\r\n\r\nThere is a preschool language reclamation project in Pajala. [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "moribund",
        "source": "glottolog-cldf-v5.3",
        "note": "Meänkieli (fit-fit) = 8a (Moribund). Provincially recognized language in administrative area municipalities: Gällivare, Haparanda, Kalix, Kiruna, Luleå, Pajala, Stockholm, Umeå, and Övertoneå (2009, NMNML Act No. 724, Article 6).",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Severely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
  },
