  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "\"The traditional culture, to which the language is closely tied, is being torn apart at a rapid pace as\r\nDhimals find themselves thrust into a cash economy without skills or a land base. Dhimals are marrying non-Dhimals, while others are only teaching their children to speak Nepali. Some individuals and families\r\nare adopting the dominant hill culture to the point of complete linguistic assimilation. Things are changing at such a pace that it is difficult to imagine this language being spoken after more than a generation or two, unless a concerted effort is made in that direction.\" (pg. 16) [Endangerment.Certainty: 0.4]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "severely endangered",
        "source": "elcat-v2024.1",
        "note": "...[T]he variety spoken in India is highly endangered...The Dhimal community mostly speaks Rajbanshi and Bengali...Only people above the ae of sixty can speak fluent Dhimal. [Endangerment.Certainty: 0.8]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "vulnerable",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Dhimal (4076-dhi) = Endangered (40 percent certain, based on the evidence available) (\"The traditional culture, to which the language is closely tied, is being torn apart at a rapid pace as\r\nDhimals find themselves thrust into a cash economy without skills or a land base. Dhimals are marrying non-Dhimals, while others are only teaching their children to speak Nepali. Some individuals and families\r\nare adopting the dominant hill culture to the point of complete linguistic assimilation. Things are changing at such a pace that it is difficult to imagine this language being spoken after more than a generation or two, unless a concerted effort is made in that direction.\" (pg. 16)) [King 2008](cldf:king:08)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
