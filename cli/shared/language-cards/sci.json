  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "Five communities (Colombo, Slave Island, Kandy & other Upcountry, Hambantota, and Kirinda) have been examined, and the results indicate that Sri Lanka Malay is no longer acquired by younger generation whereas in other communities (exclusive of Kirinda) Sri Lanka Malay is mainly used by old-middle generations. By contrast, Sri Lanka Malay is used in all domains in Kirinda. [Endangerment.Certainty: 0.8]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.4]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "vulnerable",
        "source": "elcat-v2024.1",
        "note": "In the Colombo Malay community, \"[i]n general, the community typically shows strong linguistic vitality in SLM in the middle to old generations and rapidly decreasing (in many cases, to nil) linguistic competence in the vernacular in the young generation.\" [Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Sri Lanka Malay (3568-sci) = Endangered (80 percent certain, based on the evidence available) (Five communities (Colombo, Slave Island, Kandy & other Upcountry, Hambantota, and Kirinda) have been examined, and the results indicate that Sri Lanka Malay is no longer acquired by younger generation whereas in other communities (exclusive of Kirinda) Sri Lanka Malay is mainly used by old-middle generations. By contrast, Sri Lanka Malay is used in all domains in Kirinda.) [Lim and Ansaldo 2006](cldf:lim:ansaldo:06)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
