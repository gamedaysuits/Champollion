  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "Kildin, Inari, Skolt and South Sámi languages are all spoken by 300 to 1000 individuals. Although these four\r\nvarieties risk being replaced by the dominating languages, they are transmitted to children at home in some families and/or in special scholastic immersion environments known as “language nests” for a smaller number of children, and language emersion camps for adolescents. Therefore, they are not immediately threatened by extinction. [Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Inari Saami (3431-smn) = Endangered (100 percent certain, based on the evidence available) [Salminen 2007](cldf:salminen:07:2)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
