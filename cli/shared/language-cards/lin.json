  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "not endangered",
        "source": "glottolog-cldf-v5.3",
        "note": "Lingala (lin-lin) = 3 (Wider communication). Statutory language of national identity (2006, Constitution, Article 1(8)). Developed as a trade language around 1900 about halfway between Kinshasa and Kisangani. It then spread along the river, ultimately becoming entrenched in Kinshasa, where it has become the L1 of most people. Lingala has become the most prestigious language in the country apart from French [fra]. It is the language of the military and of Kinshasa jazz (popular music). It is even an international language, being a language of wider communication in Congo (Brazzaville).",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Not endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
