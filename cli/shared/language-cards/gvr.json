  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "at risk",
        "source": "elcat-v2024.1",
        "note": "decreasing [Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "\"All Gurung language communities are abandoning the language in favour of Nepali. Probably no young children are being raised in the language, so that all dialects of the language are likely to go extinct after the present generation of speakers expires.\" (p.310) [Endangerment.Certainty: 0.6]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "\"Overall, Gurung speakers have a positive attitude towards their language and have desires for development in their language. However, language vitality is declining. Gurung language use in the home, religious, village, and marketplace domains indicates younger and more educated speakers are using Gurung less than older and uneducated speakers. Nepali proficiency is reportedly high among all generations. The degree of intergenerational transfer of Gurung is low, especially by younger parents. The Gurung language is decreasingly being passed on to children and Nepali usage among even very young children is increasing. Gurung children are learning Nepali before they enter school and formal education is conducted in Nepali. These factors combined point to diminishing language vitality among the Gurung communities, especially among the younger generation.\" (p.47) [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "vulnerable",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Western Gurung (4251-gvr) = Threatened (100 percent certain, based on the evidence available) (\"Overall, Gurung speakers have a positive attitude towards their language and have desires for development in their language. However, language vitality is declining. Gurung language use in the home, religious, village, and marketplace domains indicates younger and more educated speakers are using Gurung less than older and uneducated speakers. Nepali proficiency is reportedly high among all generations. The degree of intergenerational transfer of Gurung is low, especially by younger parents. The Gurung language is decreasingly being passed on to children and Nepali usage among even very young children is increasing. Gurung children are learning Nepali before they enter school and formal education is conducted in Nepali. These factors combined point to diminishing language vitality among the Gurung communities, especially among the younger generation.\" (p.47)) [Swenson et al. 2015](cldf:swenson:eichentopf:etal:15)",
        "scale": "glottolog-cldf-v5.3"
      },
      {
        "value": "Definitely endangered",
        "source": "linguameta-452a21ad3dae",
        "scale": "linguameta-452a21ad3dae"
      }
    ]
  },
