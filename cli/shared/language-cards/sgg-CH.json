  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "In 2006, approximately 80 percent of deaf infants were implanted, many of them at as early as thirteen months of age and the medical staff usually does not encourage parents to use sign language with their deaf child.... The number of pupils in the day and residential schools for the Deaf has been steadily decreasing over the past decade, as the large majority of Swiss deaf children who have received a cochlear implant are integrated into classes with hearing children, usually without signing support.\"\r\n\"Many signers in these more recent deaf generations have learned sign language as adolescents from the adult Deaf community. [Endangerment.Certainty: 0.8]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "[Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Swiss-German Sign Language (7361-sgg) = Endangered (80 percent certain, based on the evidence available) (In 2006, approximately 80 percent of deaf infants were implanted, many of them at as early as thirteen months of age and the medical staff usually does not encourage parents to use sign language with their deaf child.... The number of pupils in the day and residential schools for the Deaf has been steadily decreasing over the past decade, as the large majority of Swiss deaf children who have received a cochlear implant are integrated into classes with hearing children, usually without signing support.\"\r\n\"Many signers in these more recent deaf generations have learned sign language as adolescents from the adult Deaf community.) [Braem and Rathmann 2010](cldf:braem:rathmann:10)",
        "scale": "glottolog-cldf-v5.3"
      }
    ]
  },
