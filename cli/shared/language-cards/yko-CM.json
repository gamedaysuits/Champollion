    "values": [
      {
        "value": "threatened",
        "source": "elcat-v2024.1",
        "note": "While Iyasa still has many speakers in their 20s, most young Iyasa-speaking parents in the Campo area report that their children have only a passive command of Iyasa. Children in Ebodje generally have active command of Iyasa, but are observed speaking mostly French in daily life. Young parents today report speaking predominantly or exclusively French with their children, whereas their parents spoke mostly Iyasa in the home. [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
