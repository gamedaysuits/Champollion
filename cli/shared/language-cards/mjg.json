  "endangerment": {
    "agreement": "incommensurable",
    "values": [
      {
        "value": "endangered",
        "source": "elcat-v2024.1",
        "note": "\"Monguor varieties are still spoken today, but the number of speakers is declining, and in some villages only a small percentage of children speak the language... while there are people classified as Tu in Datong, Mongghul is most likely no longer spoken there. There are speakers of Mongghul in Tianzhu, but not many young speakers. It seems that of people under the age of 20, only about 10% speak the language fluently. Younger people often do not know songs or traditional folktales in Mongghul.\" (p.234, 237) [Endangerment.Certainty: 1]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "vulnerable",
        "source": "elcat-v2024.1",
        "note": "Speaker number is probably decreasing. [Endangerment.Certainty: 0.2]",
        "scale": "elcat-v2024.1"
      },
      {
        "value": "shifting",
        "source": "glottolog-cldf-v5.3",
        "note": "Huzhu (2088) = Endangered (100 percent certain, based on the evidence available) (\"Monguor varieties are still spoken today, but the number of speakers is declining, and in some villages only a small percentage of children speak the language... while there are people classified as Tu in Datong, Mongghul is most likely no longer spoken there. There are speakers of Mongghul in Tianzhu, but not many young speakers. It seems that of people under the age of 20, only about 10% speak the language fluently. Younger people often do not know songs or traditional folktales in Mongghul.\" (p.234, 237)) [Faehndrich 2007](cldf:faehndrich:07)",
        "scale": "glottolog-cldf-v5.3"
