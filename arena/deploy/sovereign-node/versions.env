# Pinned versions for the sovereign-node rehearsal guests.
# Sourced by provision/*.sh and rehearse.sh. Every value here is RECORDED in
# the rehearsal report so a run is reproducible from its record.

# Guest OS (Lima template). Ubuntu 24.04 LTS ships Python 3.12 — which is why
# the offline bundle's constraints carry cp312 hashes (see arena/constraints-node.txt).
LIMA_TEMPLATE="template://ubuntu-24.04"
LIMA_VM_TYPE="vz"

# Node.js: the CLI (cli/bin/cli.js) needs >= 20.11. Resolved at provision time
# from the pinned MAJOR line and verified against nodejs.org's SHASUMS256.txt
# for that release; the resolved version lands in the report.
NODE_MAJOR="20"

# Supabase CLI (organizer only): latest GitHub release .deb, verified against the
# release's published checksums file; resolved version recorded in the report.
SUPABASE_CLI_REPO="supabase/cli"

# Docker Engine: docker-ce from Docker's apt repository (GPG-pinned by URL below),
# rootful, the guest user added to the `docker` group. Version recorded in the report.
DOCKER_APT_GPG_URL="https://download.docker.com/linux/ubuntu/gpg"
DOCKER_APT_REPO="https://download.docker.com/linux/ubuntu"

# The Lane B participant base image (pre-pulled during provisioning because the
# darkened node cannot pull; digest recorded in the report).
PYTHON_BASE_IMAGE="python:3.12-slim"

# Ceremony parameters for the rehearsal (3-of-5, five synthetic custodians).
CEREMONY_M="3"
CEREMONY_N="5"
CEREMONY_GROUP="synth-council"
SEALED_SET_ID="eval-qaa-qab-synth-secret-v1"
CONTEST_ID="synth-open-2026"

# The RELAY contest's sealed set: contest_prep derives it as
# eval-<src>-<tgt>-<slug>-secret-v1, so the node can hold a ceremony for it
# before the organizer prepares it. One ceremony per SET is doctrine (the
# shares carry the set id and the unseal refuses a mismatch), so the node runs
# one for its own fixture set and one for this.
RELAY_SET_ID="eval-qaa-qab-synth-t2-secret-v1"
