# hosts.env — for TRANSPORT=ssh (copy to hosts.env; it is gitignored).
#
# Two Linux VMs (Ubuntu 24.04, x86_64 or arm64), passwordless sudo, key-based
# ssh from this machine. Names are ssh host aliases from ~/.ssh/config; reach
# the node THROUGH the organizer so it needs no route of its own:
#
#   Host champ-org
#     HostName 192.168.122.10
#     User ubuntu
#   Host champ-node
#     HostName 10.10.0.20          # isolated bridge, reachable from the organizer only
#     User ubuntu
#     ProxyJump champ-org
#
# For the strongest tier, detach the node's NAT NIC at the hypervisor after
# `rehearse.sh provision airgap`; management continues over the isolated bridge.
ORG_SSH=champ-org
NODE_SSH=champ-node
