# OpenRouter API key (required for remote LLM evaluation)
# Get one at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL infrastructure configuration. Each variable is
# read by the harness (arena/) or the training suite (forge/); defaults apply
# when unset. Never commit real values — this file documents names only.
# ---------------------------------------------------------------------------

# --- Provider API keys (only for the providers you actually use) -----------
# ANTHROPIC_API_KEY=            # Anthropic first-party provider (providers/anthropic_provider.py)
# GEMINI_API_KEY=               # Google Gemini first-party provider (providers/gemini_provider.py)
# GOOGLE_API_KEY=               # Fallback key name honored by the Gemini provider
# LOCAL_API_BASE=               # Base URL for a local OpenAI-compatible server (providers/local_provider.py)

# --- Publishing / auth (Supabase) -------------------------------------------
# MT_EVAL_SUPABASE_URL=         # Override the Supabase project URL (auth.py; point at a staging branch)
# MT_EVAL_SUPABASE_ANON_KEY=    # Override the anon/publishable key (auth.py)
# MT_EVAL_SUPABASE_SERVICE_KEY= # service_role key for organizer/verifier lanes (sovereign_service.py, verifier.py) — never ship
# MT_EVAL_REFRESH_TOKEN=        # Non-interactive auth: a pre-issued refresh token (auth.py)
# MT_EVAL_TOKEN_PATH=           # Where the session refresh token is persisted (default ~/.mt-eval/auth.json)
# MT_EVAL_ALLOW_PROD=           # 1/true: allow publish/organizer machinery against PRODUCTION (publish.py, sovereign_service.py) — founder go-ahead required
# SUPABASE_URL=                 # arena/scripts utilities (backfill_paradigm.py) — plain names, same project
# SUPABASE_ANON_KEY=            # read key for those scripts
# SUPABASE_SERVICE_ROLE_KEY=    # write key for those scripts — never ship
# SUPABASE_SERVICE_KEY=         # fallback name honored by generate_sweep_queue.py

# --- Queue -------------------------------------------------------------------
# CHAMPOLLION_QUEUE_SOURCE=     # Queue source for `mt-eval queue` (default "db" = live Postgres queue; or a queue.json path/URL) (queue_runner.py)
# MT_EVAL_NO_COVERAGE_SKIP=     # 1/true: disable the already-covered skip check in the queue runner (queue_runner.py)

# --- Language cards / registry / data resolution -----------------------------
# MT_EVAL_CARDS_DIR=            # Local language-cards directory (offline/air-gapped; language_cards.py)
# CHAMPOLLION_CARDS_DIR=        # Interop alias for MT_EVAL_CARDS_DIR
# CHAMPOLLION_SHARED_DIR=       # Override for the shared/ catalogue directory (language_cards.py, forge)
# MT_EVAL_NO_REMOTE_REGISTRY=   # 1/true: air-gap — never fetch the registry/cards from Supabase (config.py, language_cards.py)
# CHAMPOLLION_OFFLINE=          # CLI-interop alias for the air-gap toggle
# MT_EVAL_DATA_ROOT=            # Root for fetched datasets + caches (config.py, corpus_fetch.py)

# --- forge (training suite) --------------------------------------------------
# MT_EVAL_HARNESS_PATH=         # Explicit path to the arena harness checkout (forge/nmt_forge/_harness.py)
# NMT_FORGE_NO_MONITOR=         # 1: disable the forge training monitor (forge/nmt_forge/monitor.py)
# CHAMPOLLION_CLI=              # Explicit path to the champollion CLI entrypoint (contest_prep.py)

# --- Misc --------------------------------------------------------------------
# MT_EVAL_AUTO_SETUP=           # 1/true: auto-install eval-standard deps without prompting (plugin_discovery.py)
# SACREBLEU=                    # sacrebleu's own cache dir (set by corpora-builder's WMT adapter when unset)
# CI=                           # 1/true: CI mode — corpus_fetch tightens behavior for CI runs

# --- Test-only ---------------------------------------------------------------
# MT_EVAL_TEST_DB_URL=          # Postgres DSN of a DEV/STAGING branch for live-DB guard tests (never prod)
